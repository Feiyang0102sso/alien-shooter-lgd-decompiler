# --- IDE configuration file ---
.idea/

# --- Python cached files (standard ignore) ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.vscode/

# --- pyproject ---
*.egg-info/

# --- environment ---
.venv/

# --- LOGS ---
*.log
# !AlienShooterLastHope.log

# --- pyinstaller ---
build/
dist/

# --- Sample Lgd ---
.bak/
*.zip
.lgd_sample/
*.asm
*.lgd
*.lgc
*.csv
*.c
*.h
*.json
_sample/


# --- allow test data ---
!tests/fixtures/**

# --- allow lgc in bug docs ---
!_bug_docs/**/*.lgc
!_bug_docs/**/*.map
!_bug_docs/**/*.asm

# --- regression test runtime (keep fixtures only) ---
tests/output/


# --- unneeded intermedia via scripting ---
scripts/**/data
scripts/**/output
scripts/endless_loop_detect/*.txt


# !lgc_compiler.exe.c





