// ==========================================
// addr_of_assign.lgc
// 变体：&arr[i] 直接赋值
// 泄漏的下标被 ASSIGN 吃掉，跑到等号左边：
//   反编译得到 main_local5[main_local4] = (&main_local0);
// ==========================================

main()
{
  string pathName[4];
  int i;
  int p;
  for (i = 0; i < 4; ++i)
  {
    pathName[i] = "path";
    p = &pathName[i];
  }
}
